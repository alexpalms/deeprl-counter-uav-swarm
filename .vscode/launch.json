{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/rl_cuas/cli.py",
            "args": [
                "train",
                "--config", "${input:config}",
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/rl_cuas/cli.py",
            "args": [
                "evaluate",
                "--policy", "${input:policy}",
                "--n_episodes", "${input:n_episodes}",
                "--seed", "${input:seed}",
                //"${input:no_render}",
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Comparative Evaluation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/rl_cuas/cli.py",
            "args": [
                "compare",
                "--n_episodes", "${input:n_episodes}",
                "--seeds", "${input:seeds}",
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "config",
            "type": "pickString",
            "description": "Select the training configuration file",
            "options": ["./examples/config.yaml"],
            "default": "./examples/config.yaml"
        },
        {
            "id": "policy",
            "type": "pickString",
            "description": "Select the policy",
            "options": ["random", "deeprl", "classic"],
            "default": "random"
        },
        {
            "id": "n_episodes",
            "type": "promptString",
            "description": "Select the number of episodes",
            "default": "1"
        },
        {
            "id": "seed",
            "type": "promptString",
            "description": "Select the seed",
            "default": "42"
        },
        {
            "id": "seeds",
            "type": "promptString",
            "description": "Select the seeds",
            "default": "10 20 30 42 50"
        }
    ]
}
