{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Type Hints Checks - Pyright",
        "type": "shell",
        "command": "uv run pyright",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Type Hints Checks - Mypy",
        "type": "shell",
        "command": "uv run mypy --strict",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Code Formatting Checks - Ruff check",
        "type": "shell",
        "command": "uv run ruff check .",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Code Formatting Checks - Ruff format",
        "type": "shell",
        "command": "uv run ruff format --check .",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "All Code Quality Checks",
        "dependsOn": [
          "Type Hints Checks - Pyright",
          "Type Hints Checks - Mypy",
          "Code Formatting Checks - Ruff check",
          "Code Formatting Checks - Ruff format"
        ],
        "dependsOrder": "sequence",
        "type": "shell",
        "command": "echo All checks completed!",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Pre-commit Checks",
        "type": "shell",
        "command": "uv run pre-commit run --all-files",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Pytest",
        "type": "shell",
        "command": "uv run pytest",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Train",
        "type": "shell",
        "command": "uv run rl-cuas-cli train --config ${input:config}",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Evaluate",
        "type": "shell",
        "command": "uv run rl-cuas-cli evaluate --policy ${input:policy} --n_episodes ${input:n_episodes} --seed ${input:seed}",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Compare",
        "type": "shell",
        "command": "uv run rl-cuas-cli compare --n_episodes ${input:n_episodes} --seeds ${input:seeds}",
        "group": "none",
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "config",
        "type": "pickString",
        "description": "Select the training configuration file",
        "options": ["./examples/config.yaml"],
        "default": "./examples/config.yaml"
      },
      {
          "id": "policy",
          "type": "pickString",
          "description": "Select the policy",
          "options": ["random", "deeprl", "classic"],
          "default": "random"
      },
      {
          "id": "n_episodes",
          "type": "promptString",
          "description": "Select the number of episodes",
          "default": "1"
      },
      {
          "id": "seed",
          "type": "promptString",
          "description": "Select the seed",
          "default": "42"
      },
      {
          "id": "seeds",
          "type": "promptString",
          "description": "Select the seeds",
          "default": "10 20 30 42 50"
      }
    ]
}
